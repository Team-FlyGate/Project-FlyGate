# FlyGate 가 읽는 키입니다. 이 파일을 .env 로 복사해 값을 채우세요:  cp .env.example .env
# .env 는 커밋하지 않습니다(.gitignore). CLI 만 쓴다면 이 파일 대신 flygate 실행 후 /login 으로 넣어도 됩니다.
#
# Keys FlyGate reads. Copy this file to .env and fill in the values:  cp .env.example .env
# .env is never committed. If you only use the CLI, you can run `flygate` and type /login instead.

# 필수 / required — NVIDIA NIM (Nemotron, BioNeMo). 발급: https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=nvapi-...

# 선택 / optional — 비자기회귀 판단 모델 Jev (TypeSafe AI). 없으면 판단이 필요한 명령은 '사람 확인'으로 돌립니다.
# Without it, commands that need a judgment fall back to "needs human review".
TYPESAFE_API_KEY=
